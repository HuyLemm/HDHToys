{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{dist/**,node_modules/dejavu-fonts-ttf/ttf/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
