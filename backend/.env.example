# Lấy connection string từ Neon dashboard (Connection Details -> Pooled connection)
# Dạng: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

PORT=4000
JWT_SECRET="change-me-to-a-random-string"

# Danh sách origin frontend được phép gọi API (CORS), phân tách bằng dấu phẩy.
# KHÔNG để trống/mở toàn bộ (*) trên production — chỉ liệt kê đúng domain frontend thật.
CORS_ORIGINS="http://localhost:8444"

# Tài khoản Admin đầu tiên do `prisma db seed` tạo — để trống SEED_ADMIN_PASSWORD
# thì hệ thống tự sinh mật khẩu ngẫu nhiên và in ra console DUY NHẤT MỘT LẦN lúc
# seed (xem log ngay sau khi deploy lần đầu). Không dùng mật khẩu mặc định như
# "admin123" vì đó là điểm xâm nhập đầu tiên kẻ tấn công sẽ thử.
SEED_ADMIN_EMAIL="admin@hdhtoys.vn"
SEED_ADMIN_PASSWORD=""

# Thông tin liên hệ in trên hóa đơn PDF (lib/storeConfig.ts) — bỏ trống thì
# hóa đơn không in dòng đó (không bịa hotline/địa chỉ giả).
STORE_HOTLINE=""
STORE_ADDRESS=""
STORE_WEBSITE=""
# QR Facebook/Zalo in ở cuối hóa đơn (mục "Kết nối với HDH Toys") — bỏ trống
# thì không in QR đó.
STORE_FACEBOOK_URL=""
STORE_ZALO_URL=""

# Tích hợp thanh toán QR ngân hàng (đề xuất SRS mục 3.16) — bỏ trống thì tính
# năng sinh QR/webhook đối soát tự vô hiệu (order vẫn tạo được như thường,
# chỉ không có mã QR / không tự hoàn thành qua webhook).
VIETQR_BANK_BIN=""            # Mã BIN ngân hàng theo NAPAS, ví dụ Vietcombank = 970436
VIETQR_ACCOUNT_NO=""          # Số tài khoản nhận tiền của cửa hàng
VIETQR_ACCOUNT_NAME="HDH TOYS"
VIETQR_TTL_MINUTES=15
# Secret dùng để xác thực webhook từ dịch vụ đối soát trung gian (Casso/SePay/...),
# gửi kèm theo header "X-Webhook-Secret" trên mỗi request tới /api/payments/vietqr/webhook.
VIETQR_WEBHOOK_SECRET=""
# Lớp phòng thủ thứ 2, tùy chọn — để trống thì bỏ qua. Điền dải IP cố định do
# dịch vụ đối soát công bố (phân tách bằng dấu phẩy) nếu họ có.
VIETQR_WEBHOOK_ALLOWED_IPS=""

# Object storage cho ảnh sản phẩm (S3-compatible: Cloudflare R2, AWS S3,
# Backblaze B2...), tùy chọn — để trống (mặc định) thì ảnh vẫn lưu trực tiếp
# trong Postgres như cũ. Điền đủ 4 biến dưới thì ảnh MỚI upload tự chuyển
# sang lưu ở đây (ảnh cũ đã có vẫn đọc được bình thường, không cần migrate lại).
S3_BUCKET=""
S3_ENDPOINT=""                # VD Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"               # "auto" hợp lệ cho R2; AWS S3 thật thì điền đúng region (vd "ap-southeast-1")
