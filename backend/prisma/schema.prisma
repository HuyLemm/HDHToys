generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StaffRole {
  ADMIN
  MANAGER
  ACCOUNTANT
  INVENTORY_STAFF
}

enum StaffStatus {
  ACTIVE
  LOCKED
}

model Staff {
  id           String      @id @default(cuid())
  hoTen        String
  email        String      @unique
  matKhauHash  String
  vaiTro       StaffRole
  trangThai    StaffStatus @default(ACTIVE)
  // Tăng lên mỗi khi mật khẩu bị Admin reset — nhúng vào payload JWT lúc
  // đăng nhập (lib/auth.ts) và so lại ở requireAuth mỗi request. Đây là cách
  // "thu hồi" token đang tồn tại mà không cần một bảng session/blacklist
  // riêng: đổi mật khẩu xong, mọi token cũ (dù còn hạn 8h) lập tức vô hiệu.
  tokenVersion Int         @default(0)
  orders       Order[]
  inventoryTransactions InventoryTransaction[]
  invoicesCreated Invoice[]
  incomeExpenses  IncomeExpense[]
  preorders    Preorder[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("staff")
}

enum ProductStatus {
  CON_HANG
  SAP_HET
  HET_HANG
  NGUNG_KINH_DOANH
}

enum LoaiSanPham {
  CO_SAN
  PRE_ORDER
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  ten            String
  barcode        String?
  danhMuc        String
  nhaCungCap     String
  anhUrl         String?
  giaVon         Int
  phiVanChuyen   Int           @default(0)
  giaBan         Int
  tonKho         Int           @default(0)
  tonKhoToiThieu Int           @default(0)
  daBan          Int           @default(0)
  trangThai      ProductStatus @default(CON_HANG)
  // Phân loại "hàng có sẵn" vs "pre-order" (hàng phải chờ về, ví dụ order từ
  // nước ngoài) — độc lập với sổ Đặt trước (Preorder), chỉ là nhãn + ngày dự
  // kiến/nhắc nhở để theo dõi, không ảnh hưởng luồng bán hàng bình thường.
  loaiSanPham    LoaiSanPham   @default(CO_SAN)
  ngayDuKienVe   DateTime?
  nhacHang       Boolean       @default(false)
  orderItems     OrderItem[]
  inventoryTransactions InventoryTransaction[]
  preorders      Preorder[]
  image          ProductImage?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([trangThai])
  @@index([danhMuc])
  @@index([nhaCungCap])
  @@index([createdAt])
  @@index([loaiSanPham])
  @@map("products")
}

// Ảnh sản phẩm nằm ở bảng riêng (không phải cột trên Product) để các API
// danh sách/chi tiết sản phẩm hiện có (Products.tsx, đơn hàng, kho...) không
// vô tình kéo theo dữ liệu ảnh nặng — Prisma chỉ join bảng này khi include
// tường minh. Lưu trực tiếp trong Postgres (bytea) thay vì ổ đĩa server vì
// Render free tier có filesystem tạm — file sẽ mất khi service restart/deploy.
model ProductImage {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

enum CustomerTier {
  NEW
  MEMBER
  VIP
}

model Customer {
  id            String         @id @default(cuid())
  hoTen         String
  sdt           String         @unique
  email         String?
  ngaySinh      DateTime?
  diaChi        String?
  luuY          String?
  linkFacebook  String?
  nguonKhachHang SalesChannel  @default(KHAC)
  hangKhachHang CustomerTier   @default(NEW)
  diemTichLuy   Int            @default(0)
  ghiChu        CustomerNote[]
  orders        Order[]
  preorders     Preorder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([hangKhachHang])
  @@index([nguonKhachHang])
  @@index([createdAt])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  noiDung    String
  nguoiTaoId String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("customer_notes")
}

enum OrderStatus {
  MOI
  DANG_XU_LY
  HOAN_THANH
  DA_HUY
  HOAN_TIEN
}

enum PaymentMethod {
  TIEN_MAT
  CHUYEN_KHOAN
  THE
  QR_CODE
}

enum SalesChannel {
  TAI_CUA_HANG
  DIEN_THOAI
  FACEBOOK
  ZALO
  TIKTOK
  KHAC
}

enum PhuongThucNhanHang {
  KHACH_TOI_LAY
  SHIP
}

enum DonViVanChuyen {
  SPX
  GRAB
  KHAC
}

model Order {
  id                  String        @id @default(cuid())
  soThuTu             Int           @unique @default(autoincrement())
  ma                  String        @unique
  khachHang           Customer      @relation(fields: [khachHangId], references: [id])
  khachHangId         String
  nhanVien            Staff         @relation(fields: [nhanVienId], references: [id])
  nhanVienId          String
  kenhBan             SalesChannel  @default(TAI_CUA_HANG)
  phuongThucThanhToan PaymentMethod
  trangThai           OrderStatus   @default(MOI)
  daThanhToan         Boolean       @default(false)
  phuongThucNhanHang  PhuongThucNhanHang @default(KHACH_TOI_LAY)
  donViVanChuyen      DonViVanChuyen?
  maVanDon            String?
  tamTinh             Int
  giamGia             Int           @default(0)
  tongCong            Int
  // Tiền cọc khách đã đặt trước khi tạo đơn (0 = không cọc). Lưu trực tiếp
  // trên Order (không chỉ tham chiếu qua Preorder.tienCoc) để đơn tạo trực
  // tiếp (không qua sổ Đặt trước) cũng cọc được, và để hóa đơn vẫn hiển thị
  // đúng số cọc dù sau này Preorder gốc có bị xóa.
  tienCoc             Int           @default(0)
  ghiChu              String?
  qrExpiresAt         DateTime?
  items               OrderItem[]
  invoice             Invoice?
  paymentTransactions PaymentTransaction[]
  preorder            Preorder?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([khachHangId])
  @@index([nhanVienId])
  @@index([createdAt])
  @@index([trangThai, createdAt])
  @@index([daThanhToan])
  @@index([phuongThucNhanHang])
  @@map("orders")
}

model Invoice {
  id         String   @id @default(cuid())
  soThuTu    Int      @unique @default(autoincrement())
  soHoaDon   String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String   @unique
  nguoiTao   Staff    @relation(fields: [nguoiTaoId], references: [id])
  nguoiTaoId String
  createdAt  DateTime @default(now())

  @@index([nguoiTaoId])
  @@index([createdAt])
  @@map("invoices")
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  soLuong   Int
  donGia    Int
  giaVon    Int     @default(0)
  giamGia   Int     @default(0)
  thanhTien Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum InventoryTransactionType {
  NHAP
  XUAT
  DIEU_CHINH
  TRA_HANG
}

model InventoryTransaction {
  id              String                    @id @default(cuid())
  soThuTu         Int                       @unique @default(autoincrement())
  maGiaoDich      String                    @unique
  // onDelete: Cascade — khi xóa hẳn một sản phẩm (không phải Ngừng kinh
  // doanh), lịch sử kho của riêng SP đó không còn ý nghĩa độc lập (SP không
  // còn tồn tại để tra cứu), nên xóa theo luôn thay vì chặn xóa sản phẩm.
  product         Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  loai            InventoryTransactionType
  soLuongThayDoi  Int
  tonTruoc        Int
  tonSau          Int
  nguoiThucHien   Staff                     @relation(fields: [nguoiThucHienId], references: [id])
  nguoiThucHienId String
  thamChieu       String?
  ghiChu          String?
  createdAt       DateTime                  @default(now())

  @@index([productId])
  @@index([nguoiThucHienId])
  @@index([createdAt])
  @@index([loai])
  @@map("inventory_transactions")
}

enum TransactionKind {
  THU
  CHI
}

enum IncomeExpenseCategory {
  BAN_HANG
  NHAP_HANG
  VAN_CHUYEN
  LUONG
  DIEN_NUOC
  MARKETING
  KHAC
}

model IncomeExpense {
  id         String                @id @default(cuid())
  soThuTu    Int                   @unique @default(autoincrement())
  maPhieu    String                @unique
  loai       TransactionKind
  danhMuc    IncomeExpenseCategory
  noiDung    String
  soTien     Int
  nguoiTao   Staff                 @relation(fields: [nguoiTaoId], references: [id])
  nguoiTaoId String
  createdAt  DateTime              @default(now())

  @@index([nguoiTaoId])
  @@index([createdAt])
  @@index([loai])
  @@index([danhMuc])
  @@map("income_expenses")
}

enum DebtType {
  PHAI_THU
  PHAI_TRA
}

model Debt {
  id           String   @id @default(cuid())
  doiTuong     String
  loai         DebtType
  ngayPhatSinh DateTime
  ngayDenHan   DateTime
  soTien       Int
  daThanhToan  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([loai])
  @@index([ngayDenHan])
  @@map("debts")
}

enum PaymentReconciliationStatus {
  KHOP
  KHONG_KHOP
  SAI_SO_TIEN
}

// Ghi nhận mỗi lượt báo có nhận qua webhook từ dịch vụ đối soát VietQR.
// orderId nullable vì có thể không xác định được đơn hàng nào khớp
// (nội dung chuyển khoản không đọc được mã đơn, hoặc đơn không còn hợp lệ).
model PaymentTransaction {
  id                 String                      @id @default(cuid())
  soThuTu            Int                         @unique @default(autoincrement())
  maGiaoDichNganHang String                      @unique
  order              Order?                      @relation(fields: [orderId], references: [id])
  orderId            String?
  soTienNhan         Int
  noiDungChuyenKhoan String
  trangThaiDoiSoat   PaymentReconciliationStatus
  rawPayload         Json?
  createdAt          DateTime                    @default(now())

  @@index([orderId])
  @@index([trangThaiDoiSoat])
  @@index([createdAt])
  @@map("payment_transactions")
}

enum PreorderStatus {
  CHO_HANG
  SAN_SANG
  DA_CHUYEN_DON
  DA_HUY
}

// Sổ đặt trước (preorder), tách biệt khỏi Order — cùng cách tổ chức với Debt:
// không đụng vào state machine Order đang chạy ổn định. Khi hàng về đủ và
// nhân viên xác nhận, một Order thật được tạo (dùng chung orders.service.ts)
// và Preorder chỉ còn giữ vai trò tham chiếu lịch sử (orderId).
model Preorder {
  id            String         @id @default(cuid())
  soThuTu       Int            @unique @default(autoincrement())
  ma            String         @unique
  khachHang     Customer       @relation(fields: [khachHangId], references: [id])
  khachHangId   String
  nhanVien      Staff          @relation(fields: [nhanVienId], references: [id])
  nhanVienId    String
  // Một trong hai PHẢI có giá trị: product (SP đã có trong catalog nhưng hết
  // hàng) hoặc tenSanPhamMoi (SP hoàn toàn mới, chưa có SKU/Product thật).
  product       Product?       @relation(fields: [productId], references: [id])
  productId     String?
  tenSanPhamMoi String?
  soLuong       Int
  donGiaDuKien  Int
  tienCoc       Int            @default(0)
  trangThai     PreorderStatus @default(CHO_HANG)
  ngayDuKienCo  DateTime?
  ghiChu        String?
  order         Order?         @relation(fields: [orderId], references: [id])
  orderId       String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([khachHangId])
  @@index([productId])
  @@index([trangThai])
  @@index([createdAt])
  @@map("preorders")
}

model AccountingBalance {
  id                  String   @id @default("singleton")
  tienMat             Int      @default(0)
  tienNganHang        Int      @default(0)
  vonChuSoHuu         Int      @default(0)
  taiSanKhac          Int      @default(0)
  chiPhiChuaThanhToan Int      @default(0)
  khoanPhaiTraKhac    Int      @default(0)
  updatedAt           DateTime @updatedAt

  @@map("accounting_balance")
}
